(version 1)

# TSOT-23-8 (U5, U6) pads are 0.15 mm apart: allow it for pad-to-pad only, tracks keep the 0.2 mm netclass
(rule "fine-pitch pads"
	(constraint clearance (min 0.14mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

# USB-C receptacle: its GND pads sit close to the plastic locating pegs by design
(rule "USB-C footprint holes"
	(constraint hole_clearance (min 0.1mm))
	(condition "A.memberOfFootprint('J3')"))

# Small GND pads of the ESP32 module and USB-C: solid connection instead of thermal spokes
(rule "solid GND on small pads"
	(constraint zone_connection solid)
	(condition "A.Type == 'Pad' && A.NetName == 'GND' && (A.memberOfFootprint('U2') || A.memberOfFootprint('J3'))"))
